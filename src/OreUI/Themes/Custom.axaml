<Styles xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:controls="clr-namespace:OreUI.Controls;assembly=OreUI">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
      <ResourceInclude Source="avares://OreUI/Themes/Tokens.axaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================== TabControl / TabItem（.ore） ====================== -->
    <ControlTheme x:Key="OreTabItemTheme" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource OreTextMutedBrush}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border x:Name="PART_Back" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="PART_Bar" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Back">
        <Setter Property="Background" Value="{DynamicResource OreSurfaceHoverBrush}"/>
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="{DynamicResource OreTextBrush}"/>
      </Style>
      <Style Selector="^:selected /template/ Border#PART_Bar">
        <Setter Property="Background" Value="{DynamicResource OreAccentBrush}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="OreTabControlTheme" TargetType="TabControl">
      <Setter Property="ItemContainerTheme" Value="{StaticResource OreTabItemTheme}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <ScrollViewer DockPanel.Dock="Top"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <ItemsPresenter Name="PART_ItemsPresenter">
                <ItemsPresenter.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsPresenter.ItemsPanel>
              </ItemsPresenter>
            </ScrollViewer>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Content="{TemplateBinding SelectedContent}"/>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ====================== OrePanel ====================== -->
  <ControlTheme TargetType="controls:OrePanel">
    <Setter Property="Background" Value="{DynamicResource OrePanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OreBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ====================== OreDivider（横/竖，default/light/dark） ====================== -->
  <ControlTheme TargetType="controls:OreDivider">
    <Setter Property="Background" Value="{DynamicResource OreBorderBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"/>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.horizontal">
      <Setter Property="Height" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="^.vertical">
      <Setter Property="Width" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="^.light">
      <Setter Property="Background" Value="#2E2E2E"/>
    </Style>
    <Style Selector="^.dark">
      <Setter Property="Background" Value="#000000"/>
    </Style>
  </ControlTheme>

  <!-- ====================== OreHeader（返回 / 标题 / 关闭） ====================== -->
  <ControlTheme TargetType="controls:OreHeader">
    <Setter Property="Background" Value="{DynamicResource OrePanelBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Classes="ore secondary" Content="&#x2039;"
                    IsVisible="{TemplateBinding ShowBack}"
                    VerticalAlignment="Center" Padding="8,2" FontSize="20"/>
            <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" FontSize="16"
                       FontWeight="SemiBold" Foreground="{DynamicResource OreTextBrush}"
                       VerticalAlignment="Center" Margin="8,0"/>
            <Button Grid.Column="2" Classes="ore secondary" Content="&#x00D7;"
                    IsVisible="{TemplateBinding ShowClose}"
                    VerticalAlignment="Center" Padding="8,4" FontSize="18"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ====================== OreSpinner（旋转环） ====================== -->
  <ControlTheme TargetType="controls:OreSpinner">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Foreground" Value="{DynamicResource OreAccentBrush}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border x:Name="PART_Indicator" IsVisible="False"/>
          <Path x:Name="PART_Arc"
                Stroke="{TemplateBinding Foreground}" StrokeThickness="3"
                StrokeLineCap="Round"
                Data="M 14,2 A 12,12 0 1 1 2,14"
                Width="28" Height="28"/>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^">
      <Setter Property="RenderTransform">
        <RotateTransform/>
      </Setter>
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RenderTransform">
              <RotateTransform Angle="0"/>
            </Setter>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RenderTransform">
              <RotateTransform Angle="360"/>
            </Setter>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

  <!-- ====================== OreTag ====================== -->
  <ControlTheme TargetType="controls:OreTag">
    <Setter Property="Foreground" Value="{DynamicResource OreTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource OreSurfaceHoverBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.success">
      <Setter Property="Background" Value="{DynamicResource OreAccentBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="^.danger">
      <Setter Property="Background" Value="{DynamicResource OreDestructiveBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="^.warning">
      <Setter Property="Background" Value="#E0A800"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style Selector="^.info">
      <Setter Property="Background" Value="#2196F3"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
  </ControlTheme>

  <!-- ====================== OreMenuRow（缩略图 + 标题 + 副标题 + ›） ====================== -->
  <ControlTheme TargetType="controls:OreMenuRow">
    <Setter Property="Foreground" Value="{DynamicResource OreTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Back" Background="{TemplateBinding Background}"
                CornerRadius="6" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ContentPresenter Grid.Column="0" Content="{TemplateBinding Icon}"
                              Width="28" Height="28" VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ContentPresenter Content="{TemplateBinding Content}" FontSize="14"/>
              <TextBlock Text="{TemplateBinding Subtitle}" FontSize="11"
                         Foreground="{DynamicResource OreTextMutedBrush}"/>
            </StackPanel>
            <Path Grid.Column="2" Data="M0,0 L5,5 L0,10"
                  Stroke="{DynamicResource OreTextMutedBrush}"
                  StrokeThickness="1.5" VerticalAlignment="Center"
                  IsVisible="{TemplateBinding ShowChevron}"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Back">
      <Setter Property="Background" Value="{DynamicResource OreSurfaceHoverBrush}"/>
    </Style>
    <Style Selector="^.selected /template/ Border#PART_Back">
      <Setter Property="Background" Value="{DynamicResource OrePanelAltBrush}"/>
    </Style>
  </ControlTheme>

  <!-- ====================== OreSelectionList（ListBox 风格） ====================== -->
  <ControlTheme TargetType="controls:OreSelectionList">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="ItemContainerTheme">
      <ControlTheme TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Content="{TemplateBinding Content}"/>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ItemsPresenter/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ====================== OreModal（遮罩 + 居中面板） ====================== -->
  <ControlTheme TargetType="controls:OreModal">
    <Setter Property="Background" Value="#80000000"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid IsVisible="{TemplateBinding IsOpen}">
          <Border Background="{TemplateBinding Background}"/>
          <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{DynamicResource OrePanelBrush}"
                  BorderBrush="{DynamicResource OreBorderBrush}"
                  BorderThickness="1" CornerRadius="8"
                  Padding="16" MaxWidth="420">
            <ContentPresenter Content="{TemplateBinding Content}"/>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ====================== TabControl.ore ====================== -->
  <Style Selector="TabControl.ore">
    <Setter Property="Theme" Value="{StaticResource OreTabControlTheme}"/>
  </Style>

</Styles>
