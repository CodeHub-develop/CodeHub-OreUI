<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    OreUI — Minecraft Bedrock Edition 风格 Avalonia 主题入口。
    在 App.axaml 中通过 <StyleInclude Source="avares://OreUI/Themes/OreUITheme.axaml" />
    引入后，所有标准 Avalonia 控件自动获得 OreUI 外观。
  -->
  <StyleInclude Source="avares://OreUI/Index.axaml" />
</Styles>
