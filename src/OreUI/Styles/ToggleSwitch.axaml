<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    OreUI ToggleSwitch
    官方 27×14：on 绿纹理 / off 灰纹理，12px 像素拇指。
  -->
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
      <Setter Property="OffContent" Value="" />
      <Setter Property="OnContent" Value="" />
      <Setter Property="Foreground" Value="{DynamicResource OreTextBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource OreFontFamily}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleSwitch">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Grid Grid.Column="0" Width="{DynamicResource OreToggleWidth}"
                  Height="{DynamicResource OreToggleHeight}" VerticalAlignment="Center">
              <Border x:Name="PART_Border" BorderThickness="1" BorderBrush="#0A0A0A">
                <Border.Background>
                  <ImageBrush Source="avares://OreUI/Assets/Textures/toggle_off.png" Stretch="Fill" />
                </Border.Background>
              </Border>
              <Canvas x:Name="PART_MovingKnobs">
                <Border x:Name="PART_Knob" Width="{DynamicResource OreToggleThumbSize}"
                        Height="{DynamicResource OreToggleThumbSize}" Margin="1,1,0,0">
                  <Border.Background>
                    <ImageBrush Source="avares://OreUI/Assets/Textures/thumb.png" Stretch="Fill" />
                  </Border.Background>
                  <Border.Transitions>
                    <Transitions>
                      <ThicknessTransition Property="Margin" Duration="0:0:0.12" />
                    </Transitions>
                  </Border.Transitions>
                </Border>
              </Canvas>
            </Grid>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                              VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:checked /template/ Border#PART_Border">
        <Setter Property="Background">
          <Setter.Value>
            <ImageBrush Source="avares://OreUI/Assets/Textures/toggle_on.png" Stretch="Fill" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ Border#PART_Knob">
        <Setter Property="Margin" Value="14,1,0,0" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

</Styles>
