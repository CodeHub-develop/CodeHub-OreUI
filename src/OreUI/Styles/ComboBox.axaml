<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    OreUI ComboBox / Dropdown
    field 9-slice 纹理 + chevron；弹层用 panel 纹理 + 绿色选中高亮。
  -->
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource OreTextBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource OreFontFamilyBody}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="PART_Border" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource OreSurfaceHoverBrush}" />
      </Style>
      <Style Selector="^:selected /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource OreSurfaceSelectedBrush}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
      <Setter Property="ItemContainerTheme" Value="{StaticResource {x:Type ComboBoxItem}}" />
      <Setter Property="Foreground" Value="{DynamicResource OreTextBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource OreFontFamilyBody}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="PART_Root">
            <Grid RowDefinitions="4,*,4" ColumnDefinitions="4,*,4">
              <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource OreField9TL}" />
              <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource OreField9T}" />
              <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource OreField9TR}" />
              <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource OreField9L}" />
              <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource OreField9C}" />
              <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource OreField9R}" />
              <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource OreField9BL}" />
              <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource OreField9B}" />
              <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource OreField9BR}" />

              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="10,4">
                <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                  VerticalAlignment="Center"
                                  Foreground="{TemplateBinding Foreground}" />
                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                      Stroke="{DynamicResource OreTextMutedBrush}" StrokeThickness="1.5"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="8,0,0,0" />
              </Grid>
            </Grid>

            <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                   MinWidth="{Binding #PART_Root.Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Bottom" HorizontalOffset="0" VerticalOffset="0">
              <Border BorderBrush="#0A0A0A" BorderThickness="1" Padding="2">
                <Border.Background>
                  <ImageBrush Source="avares://OreUI/Assets/Textures/panel.png" Stretch="Fill" />
                </Border.Background>
                <ScrollViewer MaxHeight="240">
                  <ItemsPresenter Name="PART_ItemsPresenter">
                    <ItemsPresenter.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ItemsPresenter.ItemsPanel>
                  </ItemsPresenter>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

</Styles>
