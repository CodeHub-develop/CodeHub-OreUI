<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    OreUI ListBox / ListBoxItem
    设置页导航等列表：行高 27，选中基岩绿高亮白字。
  -->
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource OreTextBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource OreFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="PART_Border" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource OreSurfaceHoverBrush}" />
      </Style>
      <Style Selector="^:selected /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource OreAccentBrush}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox">
      <Setter Property="ItemContainerTheme" Value="{StaticResource {x:Type ListBoxItem}}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter Name="PART_ItemsPresenter" />
          </ScrollViewer>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

</Styles>
