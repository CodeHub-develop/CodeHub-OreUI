<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    OreUI TabControl / TabItem — 忠实复刻 Bedrock 顶部导航标签栏：
    · 每个标签 = 小图标 + 文字（Header 可放任意内容，演示用 McTextBlock 渲染 MC 表情+文字）
    · 未选中 = 面板底 + 右侧细分隔线，文字浅灰
    · 选中   = 更亮的灰底（非绿按钮）+ 左侧亮边，文字转白
    · hover / pressed 走 Opacity 过渡淡入淡出（与 Button 同款手感）
  -->
  <Styles.Resources>
    <!-- 标签栏专用表面色（不污染全局 Token） -->
    <SolidColorBrush x:Key="OreTabSelectedBrush">#2E2E2E</SolidColorBrush>
    <SolidColorBrush x:Key="OreTabHoverBrush">#262626</SolidColorBrush>
    <SolidColorBrush x:Key="OreTabPressedBrush">#161616</SolidColorBrush>
    <SolidColorBrush x:Key="OreTabLeftEdgeBrush">#7C7C7C</SolidColorBrush>

    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource OreTextMutedBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource OreFontFamily}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TabItem">
          <Grid>
            <!-- 选中底：更亮灰（非绿） -->
            <Border x:Name="PART_SelectedFace" Background="{DynamicResource OreTabSelectedBrush}"
                    IsVisible="False" />
            <!-- 未选中底：透明，露出标签条面板色 -->
            <Border x:Name="PART_Back" Background="Transparent" />

            <!-- hover 提亮层（淡入淡出） -->
            <Border x:Name="PART_Hover" Background="#1AFFFFFF" Opacity="0"
                    IsHitTestVisible="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <!-- pressed 压暗层 -->
            <Border x:Name="PART_Pressed" Background="#2A000000" Opacity="0"
                    IsHitTestVisible="False">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
              </Border.Transitions>
            </Border>

            <!-- 右侧细分隔线（未选中时显示） -->
            <Border x:Name="PART_Divider" BorderBrush="{DynamicResource OreDividerDefaultBrush}"
                    BorderThickness="0,0,1,0" />
            <!-- 选中左亮边 -->
            <Border x:Name="PART_LeftEdge" BorderBrush="{DynamicResource OreTabLeftEdgeBrush}"
                    BorderThickness="0" IsVisible="False" />

            <!-- 标签内容（图标+文字），水平居中 -->
            <ContentPresenter x:Name="PART_Header" Content="{TemplateBinding Header}"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:selected /template/ Border#PART_SelectedFace">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:selected /template/ Border#PART_Divider">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:selected /template/ Border#PART_LeftEdge">
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_Header">
        <Setter Property="Foreground" Value="{DynamicResource OreTextBrush}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#PART_Hover">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Pressed">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Hover">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^:disabled /template/ Border#PART_Hover">
        <Setter Property="Opacity" Value="0" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
      <Setter Property="ItemContainerTheme" Value="{StaticResource {x:Type TabItem}}" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <!-- 标签条：面板底 + 底部 1px 分隔线 -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource OrePanelBrush}"
                    BorderBrush="{DynamicResource OreDividerDefaultBrush}"
                    BorderThickness="0,0,0,1">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <ItemsPresenter Name="PART_ItemsPresenter">
                  <ItemsPresenter.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="0" />
                    </ItemsPanelTemplate>
                  </ItemsPresenter.ItemsPanel>
                </ItemsPresenter>
              </ScrollViewer>
            </Border>
            <!-- 内容区 -->
            <Border Background="{DynamicResource OrePanelBrush}">
              <ContentPresenter Name="PART_SelectedContentHost"
                                Content="{TemplateBinding SelectedContent}" />
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

</Styles>
