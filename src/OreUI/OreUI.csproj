<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>CodeHub-OreUI</PackageId>
    <Version>1.1.0</Version>
    <Title>CodeHub-OreUI</Title>
    <Description>OreUI — Minecraft Bedrock Edition 风格的 Avalonia 控件库（面板 / 按钮 / 开关 / 滑块 / 下拉 / 列表 / 标签页 / 模态 等）。</Description>
    <PackageTags>avalonia;minecraft;bedrock;oreui;ui-controls</PackageTags>
    <RootNamespace>OreUI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Authors>CodeHub</Authors>
    <Company>CodeHub</Company>
    <Product>CodeHub-OreUI</Product>
    <PackageProjectUrl>https://github.com/CodeHub-develop/CodeHub-OreUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CodeHub-develop/CodeHub-OreUI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.1.0 — faithful OreUI rebuild: button/panel/tab textures regenerated to match real Bedrock OreUI CSS (solid fill + bottom 2px bevel + corner highlights, no border/gradient); exact wiki colors for primary/destructive/realms/tab/disabled; aligned design tokens.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
  </ItemGroup>

</Project>
